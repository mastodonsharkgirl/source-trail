    {
      "id": "cedar-travel-current",
      "title": "Cedar travel policy",
      "version": "2026-10",
      "text": "Cedar employees may claim rail travel booked at least seven days ahead. This current rule replaces the former three-day booking window.\n\nCedar claims above 500 fictional credits require an itemised receipt; the former rule used 300 credits.\n\nA current itinerary change needs the original booking reference within one working day; the former rule allowed two days.\n\nStandard rail fare is the current claim class unless a manager records a fictional exception; the former rule named flexible fare.",
      "tenant": "cedar",
      "allowedRoles": [
        "employee",
        "manager",
        "security"
      ],
      "policyKey": "travel",
      "authority": "published",
      "status": "current",
      "effectiveOn": "2026-10-01",
      "expiresOn": null,
      "supersedes": [
        "cedar-travel-obsolete"
      ]
    },
    {
      "id": "cedar-travel-obsolete",
      "title": "Cedar travel policy archive",
      "version": "2026-06",
      "text": "Cedar staff could claim rail travel booked three days ahead. This retained archive is no longer current.\n\nThe archived policy required an itemised receipt above 300 fictional credits.\n\nThe archived itinerary rule allowed a change request within two working days.\n\nThe archived policy named flexible rail fare as the claim class.",
      "tenant": "cedar",
      "allowedRoles": [
        "employee",
        "manager",
        "security"
      ],
      "policyKey": "travel",
      "authority": "published",
      "status": "obsolete",
      "effectiveOn": "2026-06-01",
      "expiresOn": null,
      "supersedes": []
    },
