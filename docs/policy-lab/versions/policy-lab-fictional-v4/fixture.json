    {
      "id": "cedar-remote-a",
      "title": "Cedar remote work A",
      "version": "2026-10",
      "text": "Cedar employees may work remotely two days each week when their manager has recorded the schedule.\n\nRemote work A requires the schedule record to name two chosen weekdays.\n\nRemote work A requires a manager email before the first remote day.\n\nRemote work A requires only a manager to record and approve the schedule.",
      "tenant": "cedar",
      "allowedRoles": [
        "employee",
        "manager",
        "security"
      ],
      "policyKey": "remote-work",
      "authority": "published",
      "status": "current",
      "effectiveOn": "2026-10-01",
      "expiresOn": null,
      "supersedes": []
    },
    {
      "id": "cedar-remote-b",
      "title": "Cedar remote work B",
      "version": "2026-10",
      "text": "Cedar employees may work remotely three days each week after a manager records the schedule. This rule has equal authority to remote work A.\n\nRemote work B requires only a security reviewer to record the schedule and name three chosen weekdays.\n\nRemote work B requires only a team-calendar entry before the first remote day and forbids a manager email as approval.\n\nRemote work B says a manager or security reviewer may approve the schedule.",
      "tenant": "cedar",
      "allowedRoles": [
        "employee",
        "manager",
        "security"
      ],
      "policyKey": "remote-work",
      "authority": "published",
      "status": "current",
      "effectiveOn": "2026-10-01",
      "expiresOn": null,
      "supersedes": []
    },
