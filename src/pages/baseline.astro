import '@fontsource-variable/geist';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Find exact passages in your notes with a small model running in your browser. Follow every match back to its source." /><meta name="theme-color" content="#F3EFE5" /><title>Evidence Desk — Source Trail retrieval baseline</title><link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" /></head><body><a href="#desk" class="skip-link">Skip to source desk</a><div class="page-frame"><header class="site-header"><a class="wordmark" href={import.meta.env.BASE_URL} aria-label="Source Trail home"><span aria-hidden="true" class="brand-icon">s↗</span>source trail<span class="wordmark-period">.</span></a><a href="#methodology">How it works <span aria-hidden="true">↗</span></a></header><main id="desk"><section class="hero"><div><p class="eyebrow">EVIDENCE DESK · ORIGINAL RETRIEVAL BASELINE</p><h1>Find the passage.<br /><em>Keep the source.</em></h1></div><div class="hero-note"><span class="hero-note-rule" aria-hidden="true"></span><p>Six fictional notes.<br />Exact passages.<br />No generated answer.</p><span class="hero-local"><span aria-hidden="true">●</span> Made to run in your browser</span></div></section><SourceDesk client:load /><noscript><p>This interactive source desk needs JavaScript. You can still read the <a href={`${import.meta.env.BASE_URL}evidence/source-trail-fixture.json`}>fictional source pack</a> and <a href={`${import.meta.env.BASE_URL}evidence/evaluation.json`}>evaluation</a>.</p></noscript></main><footer class="site-footer"><span class="wordmark">source trail.</span><p>Follow the evidence. Make your own reading.</p><a href={`${import.meta.env.BASE_URL}evidence/README.txt`}>Project notes ↗</a></footer></div></body></html>
